# Supabase — EU-West Frankfurt (PRD §15.4)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER exposed to client — server/Edge Function only (PRD §23.7)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — server-side only (PRD §23.10)
OPENAI_API_KEY=sk-...

# Stripe (PRD §7.3)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# RevenueCat (PRD §7.3)
REVENUECAT_API_KEY=your-revenuecat-key
REVENUECAT_WEBHOOK_SECRET=your-webhook-secret

# App
NEXT_PUBLIC_APP_URL=https://inburgering.app
NODE_ENV=development
